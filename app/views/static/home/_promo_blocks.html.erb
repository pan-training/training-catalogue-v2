<ul class="promo-blocks" id="promo-blocks">
  <% promo_blocks_list.each do |block| %>
    <li>
      <%= image_tag("#{theme_path}/icons/#{block[:icon]}") %>
      <h4 class="text-primary"><%== t "home.promo.#{block[:key]}.title" %></h4>
      <p><%== t "home.promo.#{block[:key]}.description" %></p>
    </li>
  <% end %>
</ul>
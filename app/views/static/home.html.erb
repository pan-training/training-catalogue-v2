<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "WebSite",
  "name": "<%= TeSS::Config.site['title_short'] -%>",
  "alternateName": "<%= TeSS::Config.site['title'] -%>",
  "url": "<%= root_url %>",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "<%= search_url(q: 'QUERY').sub('QUERY', '{search_term_string}') -%>",
    "query-input": "required name=search_term_string"
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "Organization",
  "url": "<%= root_url -%>",
  "logo": "<%= image_url TeSS::Config.site['logo'] -%>"
}
</script>

<% promo_side_by_side = home_page_section_enabled?('promo_blocks') && promo_blocks_next_to_welcome? %>
<% welcome_partial = current_space.default? ? 'static/home/welcome' : 'static/home/space_welcome' %>

<%= render partial: 'communities/banner' if current_space.default? && TeSS::Config.site.dig('home_page', 'communities') %>

<% if promo_side_by_side %>
  <div class="tesshub-front">
    <div class="row">
      <div class="col-md-8">
        <%= render partial: welcome_partial %>
      </div>
      <div class="col-md-4">
        <%= render partial: 'static/home/promo_blocks' %>
      </div>
    </div>
  </div>
<% else %>
  <%= render partial: welcome_partial %>
<% end %>

<%= render partial: 'static/home/additional_links' if current_space.default? && TeSS::Config.site.dig('home_page', 'additional_links') %>

<% if home_page_section_enabled?('counters') %>
  <% if current_space.default? %>
    <%= render partial: 'static/home/counters' %>
  <% else %>
    <%= render partial: 'static/home/counters', locals: { features: ['events', 'materials', 'workflows', 'learning_paths'] } %>
  <% end %>
<% end %>

<%= render partial: 'static/home/catalogue_blocks' if home_page_section_enabled?('catalogue_blocks') %>

<%= render partial: 'static/home/provider_carousel' if home_page_section_enabled?('provider_carousel') %>

<%= render partial: 'static/home/provider_grid' if home_page_section_enabled?('provider_grid') %>

<%= render partial: 'static/home/faq' if home_page_section_enabled?('faq') && TeSS::Config.site.dig('home_page', 'faq')&.any? %>

<%= render partial: 'static/home/promo_blocks' if home_page_section_enabled?('promo_blocks') && !promo_side_by_side %>

<%= render partial: 'static/home/upcoming_events' if @events.present? %>

<%= render partial: 'static/home/latest_materials' if @materials.present? %>

<%= render partial: 'static/home/featured_trainer' if TeSS::Config.site.dig('home_page', 'featured_trainer') %>
